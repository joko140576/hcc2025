<style>
body{
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(180deg,#f4f8ff,#ffffff);
    color:#333;
}

/* NAVBAR */
.navbar{
    background: rgba(255,255,255,0.9);
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}
.navbar-brand{
    font-weight:700;
    color:#0d6efd !important;
}
.nav-link{
    color:#333 !important;
    margin-right:15px;
    font-weight:500;
}
.nav-link:hover{
    color:#0d6efd !important;
}

/* HERO */
.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
}
.hero h1{
    font-size:3rem;
    font-weight:700;
}
.hero span{
    color:#0d6efd;
}
.hero p{
    color:#555;
}


/* SECTION */
.section{
    padding:80px 0;
}

/* CARD */
.hcc-card{
    background:#fff;
    border-radius:20px;
    padding:30px;
    box-shadow:0 10px 25px rgba(0,0,0,0.08);
    transition:0.4s;
    height:100%;
}
.hcc-card:hover{
    transform:translateY(-10px);
}
.hcc-card i{
    font-size:42px;
    margin-bottom:15px;
}
.icon-blue{color:#0d6efd;}
.icon-green{color:#20c997;}
.icon-orange{color:#fd7e14;}
.icon-purple{color:#6f42c1;}
.icon-red{color:#dc3545;}
.icon-yellow{color:#ffc107;}

/* BUTTON */
.btn-hcc{
    background:#0d6efd;
    color:#fff;
    border-radius:50px;
    padding:12px 30px;
}
.btn-hcc:hover{
    background:#0b5ed7;
}

/* FOOTER */
footer{
    background:#f1f4f9;
    padding:20px;
    text-align:center;
    font-size:14px;
    color:#666;
